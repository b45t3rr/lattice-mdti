# MDTI configuration — copy to .env and fill in. NEVER commit .env.
# Variable names and non-secret defaults only. See SPEC.md §9.

# --- Anduril Lattice Sandbox ---------------------------------------------
# Hostname only, no scheme: <environment_id>.env.sandboxes.developer.anduril.com
# (The offline sandbox uses http://127.0.0.1:8740; `make demo-offline` sets it for you.)
LATTICE_ENDPOINT=
# Default auth: environment token (Lattice Auth Token from the environment page)
ENVIRONMENT_TOKEN=
# Account-level sandbox token (sent as "anduril-sandbox-authorization: Bearer <token>")
SANDBOXES_TOKEN=
# Optional OAuth2 client-credentials override (used only if ENVIRONMENT_TOKEN is empty)
LATTICE_CLIENT_ID=
LATTICE_CLIENT_SECRET=
MDTI_INTEGRATION_NAME=mdti
LATTICE_MAX_PUBLISH_PER_SEC=40

# --- Telemetry sources -------------------------------------------------------
# Sources mdti reads (docs/SOURCES.md). Aggregators: adsb, aisstream. Your own receivers:
# readsb:http://<rx>:8080, sbs:<rx>:30003, nmea-udp::10110, nmea-tcp:<host>:<port>.
SOURCES=adsb,ais
# Aggregator for "adsb": adsbfi (default, 1 req/s, non-commercial) | adsblol (500 req/day → 180 s floor)
ADSB_SOURCE=adsbfi
# Coverage: the aggregator query area, or your own antenna's position and range.
ADSB_CENTER_LAT=-34.70
ADSB_CENTER_LON=-58.55
ADSB_RADIUS_NM=60
ADSB_POLL_INTERVAL=1s
AISSTREAM_API_KEY=
# minLat,minLon,maxLat,maxLon
# Includes the Río de la Plata: terrestrial AIS coverage south of 36°S is very sparse.
AIS_BBOX=-56,-70,-34,-52

# --- Tier 1 ------------------------------------------------------------------

TIER1_COOLDOWN=120s

# --- Tier 2 (OpenAI) ---------------------------------------------------------
OPENAI_API_KEY=
# Decisions API — gpt-6-luna is the only supported model (SPEC §7.2)
OPENAI_DECISIONS_MODEL=gpt-6-luna
TIER2_CONCURRENCY=2
TIER2_MAX_CALLS_PER_MIN=10

# --- C2 ----------------------------------------------------------------------
# advisory | supervised | autonomous
AUTONOMY_LEVEL=supervised

# --- Red team / misc ---------------------------------------------------------
REDTEAM_SEED=42
LOG_LEVEL=info
LOG_FORMAT=text
